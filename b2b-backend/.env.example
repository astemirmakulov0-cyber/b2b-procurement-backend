DATABASE_URL="postgresql://user:password@localhost:5432/b2b_procurement?schema=public"
# Required. At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="change_this_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"
PORT=4000
# Error reporting; leave empty to disable Sentry (local dev)
SENTRY_DSN=""
# Transactional email (verification, password reset)
RESEND_API_KEY=""
# Base URL of the frontend, used in email links
FRONTEND_URL="http://localhost"
