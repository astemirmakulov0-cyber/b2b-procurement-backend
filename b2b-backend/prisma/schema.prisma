generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SUPPLIER
  ADMIN
}

enum CompanyType {
  BUYER
  SUPPLIER
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum RFQStatus {
  DRAFT
  PUBLISHED
  QUOTING_CLOSED
  AWARDED
  CANCELLED
}

enum QuoteStatus {
  SUBMITTED
  SHORTLISTED
  AWARDED
  REJECTED
  WITHDRAWN
}

enum LPOStatus {
  ISSUED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum OrderStatus {
  CONFIRMED
  IN_PROGRESS
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum WalletTxType {
  TOPUP
  BID_DEBIT
  REFUND
  ADJUSTMENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  emailVerified  Boolean  @default(false)
  verificationToken String? @unique
  verificationExpires DateTime?
  resetToken   String?  @unique
  resetExpires DateTime?
  // bumped on every password change/reset; JWTs carry it as `tv` and older ones are rejected
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company?
}

model Company {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id])
  name               String
  type               CompanyType
  registrationNumber String?
  country            String?
  address            String?
  phone              String?
  verificationStatus VerificationStatus  @default(PENDING)
  verificationNotes  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  documents        CompanyDocument[]
  wallet           Wallet?
  rfqsAsBuyer      RFQ[]             @relation("BuyerRFQs")
  quotesAsSupplier Quote[]           @relation("SupplierQuotes")
  catalogItems     CatalogItem[]
  lposAsBuyer      LPO[]             @relation("BuyerLPOs")
  lposAsSupplier   LPO[]             @relation("SupplierLPOs")
  messages         Message[]
  orderDocuments   OrderDocument[]
  notifications    Notification[]
  consentAt        DateTime?
  isActive         Boolean           @default(true)

}

model CompanyDocument {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  fileUrl   String
  docType   String
  uploadedAt DateTime @default(now())

  @@index([companyId])
}

model Wallet {
  id        String   @id @default(uuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(12, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String       @id @default(uuid())
  walletId  String
  wallet    Wallet       @relation(fields: [walletId], references: [id])
  amount    Decimal      @db.Decimal(12, 3)
  type      WalletTxType
  reference String?
  createdAt DateTime     @default(now())

  // wallet history: WHERE walletId ORDER BY createdAt DESC
  @@index([walletId, createdAt])
}

model RFQ {
  id             String    @id @default(uuid())
  buyerCompanyId String
  buyerCompany   Company   @relation("BuyerRFQs", fields: [buyerCompanyId], references: [id])
  title          String
  description    String
  category       String?
  quantity       Int?
  unit           String?
  budget         Decimal?  @db.Decimal(12, 3)
  deadline       DateTime?
  status         RFQStatus @default(DRAFT)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  quotes Quote[]
  // history of purchase orders: a declined LPO stays, and the RFQ can be awarded again.
  // At most one non-declined LPO per RFQ is enforced in code under the RFQ row lock.
  lpos   LPO[]

  @@index([buyerCompanyId])
  // supplier feed: WHERE status = PUBLISHED ORDER BY createdAt DESC
  @@index([status, createdAt])
}

model Quote {
  id                 String      @id @default(uuid())
  rfqId              String
  rfq                RFQ         @relation(fields: [rfqId], references: [id])
  supplierCompanyId  String
  supplierCompany    Company     @relation("SupplierQuotes", fields: [supplierCompanyId], references: [id])
  price              Decimal     @db.Decimal(12, 3)
  // only BHD for now: enforced in submitQuote and by the CHECK constraint "Quote_currency_bhd_check"
  // (migration 1_l2_l3; Prisma schema can't express CHECK constraints)
  currency           String      @default("BHD")
  deliveryTimeDays   Int?
  notes              String?
  status             QuoteStatus @default(SUBMITTED)
  // set when an award auto-rejects this quote, so it can be restored if the winner declines the LPO
  statusBeforeAward  QuoteStatus?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  lpo LPO?
  attachments QuoteAttachment[]

  // one quote per supplier per RFQ (also enforced in submitQuote; this is the DB-level guarantee)
  @@unique([rfqId, supplierCompanyId])

  // rfqId is covered by the unique (rfqId, supplierCompanyId) above
  @@index([supplierCompanyId])
}

model CatalogItem {
  id                String   @id @default(uuid())
  supplierCompanyId String
  supplierCompany   Company  @relation(fields: [supplierCompanyId], references: [id])
  name              String
  description       String?
  price             Decimal  @db.Decimal(12, 3)
  unit              String?
  category          String?
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([supplierCompanyId])
}

model LPO {
  id                 String    @id @default(uuid())
  rfqId              String
  rfq                RFQ       @relation(fields: [rfqId], references: [id])
  quoteId            String    @unique
  quote              Quote     @relation(fields: [quoteId], references: [id])
  buyerCompanyId     String
  buyerCompany       Company   @relation("BuyerLPOs", fields: [buyerCompanyId], references: [id])
  supplierCompanyId  String
  supplierCompany    Company   @relation("SupplierLPOs", fields: [supplierCompanyId], references: [id])
  terms              String?
  totalAmount        Decimal   @db.Decimal(12, 3)
  status             LPOStatus @default(ISSUED)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  order Order?

  @@index([rfqId])

  @@index([buyerCompanyId])
  @@index([supplierCompanyId])
}

model Order {
  id        String      @id @default(uuid())
  lpoId     String      @unique
  lpo       LPO         @relation(fields: [lpoId], references: [id])
  status    OrderStatus @default(CONFIRMED)
  // set when the buyer opens a dispute, so an admin can resume the order where it was
  statusBeforeDispute OrderStatus?
  // the buyer confirmed the goods arrived in the agreed quantity and quality; the invoice is payable from here
  receivedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  delivery Delivery?
  invoice  Invoice?
  messages Message[]
  documents OrderDocument[]
}

model Delivery {
  id             String         @id @default(uuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  status         DeliveryStatus @default(PENDING)
  trackingInfo   String?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Invoice {
  id          String        @id @default(uuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  amount      Decimal       @db.Decimal(12, 3)
  status      InvoiceStatus @default(ISSUED)
  dueDate     DateTime?
  issuedAt    DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments Payment[]
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(12, 3)
  method    String?
  // buyer-reported transfer/cheque/receipt number
  reference String?
  // PENDING until the supplier confirms (COMPLETED) or rejects (FAILED) it
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  decidedAt DateTime?
  rejectReason String?
  createdAt DateTime      @default(now())

  @@index([invoiceId])
}

model Message {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  // null: a comment by a platform admin (admins have no company), e.g. when resolving a dispute
  senderCompanyId  String?
  // Restrict as before: deleting a company must not turn its messages into admin comments
  senderCompany    Company? @relation(fields: [senderCompanyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  body             String
  createdAt        DateTime @default(now())

  // chat: WHERE orderId ORDER BY createdAt
  @@index([orderId, createdAt])
}

model Notification {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  type           String
  title          String
  body           String?
  relatedOrderId String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  // bell: WHERE companyId ORDER BY createdAt DESC LIMIT 50; read-all: WHERE companyId AND read = false
  @@index([companyId, createdAt])
}

// A file attached to an order: delivery note, invoice or other document. The file itself is in the private
// storage bucket under storageKey (never overwritten); only the order's parties and admins can get it.
// kind: DELIVERY_NOTE | INVOICE | OTHER | QUOTE_ATTACHMENT (CHECK constraint in the migrations, like Quote.currency).
// QUOTE_ATTACHMENT rows are the winning bid's attachments, added when the LPO is accepted; they point at the
// attachment's stored object (objects are never overwritten or deleted), so storageKey isn't unique here.
model OrderDocument {
  id                  String    @id @default(uuid())
  orderId             String
  order               Order     @relation(fields: [orderId], references: [id])
  kind                String
  // original name, shown in the list and used for the download
  fileName            String
  contentType         String
  sizeBytes           Int
  storageKey          String
  uploadedByCompanyId String
  uploadedByCompany   Company   @relation(fields: [uploadedByCompanyId], references: [id])
  createdAt           DateTime  @default(now())
  // soft delete: hidden from the list, the stored file is kept
  deletedAt           DateTime?

  // documents panel: WHERE orderId AND deletedAt IS NULL ORDER BY createdAt
  @@index([orderId, createdAt])
  @@index([storageKey])
}

// A file a supplier attaches to its quote (up to 5, 10 MB each). The file is in the private storage bucket;
// only the supplier, the RFQ's buyer and admins can see it — other suppliers learn nothing, not even the count.
// Editable only while the quote is SUBMITTED and the RFQ open for quotes; frozen after that.
model QuoteAttachment {
  id          String    @id @default(uuid())
  quoteId     String
  quote       Quote     @relation(fields: [quoteId], references: [id])
  // original name, shown in the list and used for the download
  fileName    String
  contentType String
  sizeBytes   Int
  storageKey  String    @unique
  createdAt   DateTime  @default(now())
  // soft delete: hidden from the list, the stored file is kept
  deletedAt   DateTime?

  // WHERE quoteId AND deletedAt IS NULL ORDER BY createdAt
  @@index([quoteId, createdAt])
}
